{
  "$comment": "SHARED TutorTurn validator truth table (docs/ALIZ_TUTOR_CONTRACTS.md). Run by BOTH suites: game/tests/cases/test_tutor_turn.gd (client, game/scripts/tutor/turn/tutor_turn.gd) and backend/test/validator.test.js (server, backend/src/turn_validator.js). Format: cases[].input is the candidate turn; expect is 'valid' or 'fallback'; for 'valid' cases the optional `normalized` object lists fields the validator must output exactly; for 'fallback' cases `reasonPrefix` names the rule that must appear in the reasons list. Rules: ASCII printable 0x20..0x7E only (no typographic punctuation), extra fields dropped, visual required, missing/invalid anything -> the safe fallback turn.",
  "version": 2,
  "fallback": {
    "speech": "Let's try together!",
    "emotion": "encouraging",
    "gesture": "tilt",
    "visual": {
      "type": "none"
    },
    "lessonAction": "retry"
  },
  "cases": [
    {
      "name": "minimal valid turn with no visual",
      "input": {
        "speech": "Great! What color is the apple?",
        "emotion": "happy",
        "gesture": "clap",
        "visual": {
          "type": "none"
        },
        "lessonAction": "next_question",
        "nextQuestion": "What color is the apple?"
      },
      "expect": "valid",
      "normalized": {
        "subtitle": "Great! What color is the apple?"
      }
    },
    {
      "name": "valid flashcard with allowlisted asset",
      "input": {
        "speech": "This is an apple.",
        "subtitle": "This is an apple.",
        "emotion": "smile",
        "gesture": "point",
        "visual": {
          "type": "flashcard",
          "assetId": "apple_red"
        },
        "lessonAction": "retry"
      },
      "expect": "valid"
    },
    {
      "name": "the safe fallback turn itself is valid",
      "input": {
        "speech": "Let's try together!",
        "emotion": "encouraging",
        "gesture": "tilt",
        "visual": {
          "type": "none"
        },
        "lessonAction": "retry"
      },
      "expect": "valid"
    },
    {
      "name": "speech at exactly 160 chars is valid",
      "input": {
        "speech": "Nice! The banana is yellow. Bananas grow in warm places and monkeys love them. Can you say yellow banana with me one more time please, my dear friend? Yes, yes!",
        "emotion": "happy",
        "gesture": "nod",
        "visual": {
          "type": "none"
        },
        "lessonAction": "retry"
      },
      "expect": "valid"
    },
    {
      "name": "speech over 160 chars falls back",
      "input": {
        "speech": "Nice! The banana is yellow. Bananas grow in warm places and monkeys love them. Can you say yellow banana with me one more time please, my dear friend? Yes, yes!!",
        "emotion": "happy",
        "gesture": "nod",
        "visual": {
          "type": "none"
        },
        "lessonAction": "retry"
      },
      "expect": "fallback",
      "reasonPrefix": "speech:too_long"
    },
    {
      "name": "unknown emotion falls back",
      "input": {
        "speech": "Hello!",
        "emotion": "angry",
        "gesture": "wave",
        "visual": {
          "type": "none"
        },
        "lessonAction": "retry"
      },
      "expect": "fallback",
      "reasonPrefix": "emotion:invalid"
    },
    {
      "name": "unknown gesture falls back",
      "input": {
        "speech": "Hello!",
        "emotion": "happy",
        "gesture": "backflip",
        "visual": {
          "type": "none"
        },
        "lessonAction": "retry"
      },
      "expect": "fallback",
      "reasonPrefix": "gesture:invalid"
    },
    {
      "name": "asset not on the allowlist falls back",
      "input": {
        "speech": "Look!",
        "emotion": "happy",
        "gesture": "point",
        "visual": {
          "type": "flashcard",
          "assetId": "dinosaur_green"
        },
        "lessonAction": "retry"
