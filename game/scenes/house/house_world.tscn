; ART_BIBLE.md section 5: no ceilings -- every room is "open to a soft cream
; void". Section 7: high warm ambient fill, which is the only thing that stops
; the dark side of a form going muddy under a single directional light, and
; permanently mid-morning.
;
; Nothing is enabled here that section 7 forbids: no GI/SDFGI/VoxelGI, no SSAO,
; no SSIL, no SSR, no glow, no volumetric fog, no depth of field, no colour
; correction. Every one of those is off by default and must stay off.
[sub_resource type="Environment" id="Environment_house"]
background_mode = 1
tonemap_mode = 0
background_color = Color(0.921, 0.877, 0.806, 1)
ambient_light_source = 2
ambient_light_color = Color(1, 0.965, 0.898, 1)
ambient_light_energy = 0.62

[sub_resource type="CapsuleShape3D" id="CapsuleShape3D_buddy"]
radius = 0.22
height = 1.5

[node name="HouseWorld" type="Node3D"]
script = ExtResource("1")

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Environment_house")

; Exactly one, and never more (section 7, non-negotiable; `test_house_world.gd`
; pins the count). Mid-morning sun from the upper left, in front of the camera:
; rotation (-50 deg, -34 deg, 0), so shadows fall down-right and away, across the
; open front of the room where they can be seen.
;
; Shadows are ON, soft and half-strength. Section 7: "Shadows are what ground
; objects on the floor" -- with them off, every prop in this house floated.
[node name="DirectionalLight3D" type="DirectionalLight3D" parent="."]
