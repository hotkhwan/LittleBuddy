.env
.env.*

# Godot editor cache
game/.godot/
game/android/
*.translation

# Generated Xcode project / build output (regenerate with tools/export_ios.sh)
build/

# Native plugin build intermediates (regenerate with ios/speech_plugin/build_*.sh)
ios/speech_plugin/godot-cpp/
ios/speech_plugin/bin/
ios/speech_plugin/.sconsign.dblite
ios/speech_plugin/*.os
ios/speech_plugin/src/*.os

# NOTE: game/ios/speech_plugin/bin/ is ignored too (see the bottom of this file).
# Those compiled artifacts are what the Godot iOS export consumes, so a fresh
# clone must rebuild them before an iOS export will include speech --
# see docs/MACBOOK_HANDOFF.md for the exact commands.

# Xcode
*.xcuserstate
xcuserdata/
DerivedData/

# macOS
.DS_Store

# Generated iOS speech plugin binaries
# Both forms: `bin/` matches only a directory; a stray symlink named `bin` slipped
# into commit 1af02bb and broke the iOS export (dyld: Symbol not found at launch).
game/ios/speech_plugin/bin/
game/ios/speech_plugin/bin

# --- Meshy raw character exports -------------------------------------------
# Kept on disk at their authored paths, deliberately OUT of git history.
#
# Four raw exports are 63.6 MB, and Godot extracts their embedded textures
# beside them for another ~20 MB -- ~84 MB added permanently to a 33 MB repo,
# with no git-lfs configured. Every one of them is raw generator output that
# MUST be retopologised before it can ship (155x-248x over the triangle budget)
# and none has a rig, so none can be used as-is.
#
# The deciding argument is reversibility: adding them to git later is one
# command, while taking 84 MB back out means rewriting published history, which
# this project has forbidden outright. So the reversible choice wins.
#
# Provenance and restore steps: docs/MESHY_CHARACTER_AUDIT.md
# To include them anyway, delete this block and `git add -f` the paths.
game/assets/characters/**/*.glb
game/assets/characters/**/*.jpg
game/assets/characters/**/*.png
# ...and their .import sidecars: a committed .import whose source is ignored
# would make a fresh clone fail to load. Without them the wrapper simply
# reports the model unavailable, which it already handles.
game/assets/characters/**/*.import

# EXCEPT the optimised RUNTIME derivatives, which must survive a fresh clone.
#
# The rules above were written when the only things in this directory were the
# raw Meshy exports -- 63.6 MB of them, which is why they are excluded. The
# optimised runtime models are a different class of file and the policy in
# `game/assets_source/meshy/README.md` is explicit about it: "runtime/
# optimized, mobile-safe, what the game actually uses".
#
# Excluding them too was over-reach, and it had a concrete cost: a fresh clone
# had NO characters at all -- no caregiver in the menu, no Little Buddy, and the
# wrapper correctly but unhelpfully reporting the model unavailable on a
# teammate's machine. All six together are 3.7 MB against a 33 MB repository.
#
# Raw exports (baby_standing_v01, baby_sitting_v01, baby_sleeping_v01,
# pinkGirl_v01) stay excluded, and `export_presets.cfg` keeps them out of the
# .pck as well.
!game/assets/characters/littleBuddy/baby/babyLittleBuddy_*
!game/assets/characters/buddy/pinkGirl/pinkGirlBuddy_*

# Meshy source masters: high-res, never shipped. See game/assets_source/meshy/README.md
game/assets_source/**/*.glb
game/assets_source/**/*.jpg
game/assets_source/**/*.png
game/assets_source/**/*.import

# python bytecode from the local glb inspection tools
tools/__pycache__/

# --- Signing material: never commit a keystore or its passwords ------------
# A debug keystore is generated per-machine by tools/export_android.sh (or by
# hand, see docs/ANDROID_READINESS.md) and lives OUTSIDE the repo, under
# ~/Library/Application Support/Godot/keystores/. These rules are belt-and-
# braces for the case where someone generates one inside the working tree: a
# committed keystore is an unrevocable credential leak, and a release keystore
# in git history means losing the ability to update the app on Play at all.
*.keystore
*.jks
*.p12
*.pepk
keystore.properties

# --- Aliz Tutor backend (Agent D) ------------------------------------------
# Runtime data: sessions, usage, entitlements, idempotency keys. Never commit.
backend/data/
backend/.env
backend/node_modules/
!backend/.env.example

# Voice pack WAV masters live OUTSIDE the repo (~/Music/LittleDays/voice/).
# Only the converted OGG files ship; a stray master must never be committed.
game/assets/audio/voice/**/*.wav
game/assets/audio/voice/**/*.aif
game/assets/audio/voice/**/*.aiff
# Generated by tools/voice_convert.sh; the test suite reports the same facts.
game/assets/audio/voice/voice_pack_report.json

# --- Little Days cloud backend (Cloudflare Workers, Agent D) ---------------
# Local secrets, installed packages, miniflare state and generated types.
cloud/.dev.vars
cloud/.dev.vars.*
!cloud/.dev.vars.example
cloud/node_modules/
cloud/.wrangler/
cloud/worker-configuration.d.ts
