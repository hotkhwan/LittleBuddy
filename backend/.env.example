# Copy to backend/.env (gitignored) or export in your shell. No values are committed here.
# The server reads process.env only; there is no dotenv dependency. Load with:
#   set -a; source backend/.env; set +a; node backend/src/server.js

# --- network ---
PORT=
HOST=
CORS_ORIGINS=
TRUST_PROXY=

# --- storage (JSON files; gitignored) ---
DATA_DIR=

# --- development switches (never set in production) ---
DEV_MODE=
PARENT_APPROVAL_SECRET=
DEV_PARENT_APPROVAL_TOKEN=

# --- quota (seconds per UTC day) ---
FREE_DAILY_SECONDS=
FAMILY_CLUB_DAILY_SECONDS=
TUTOR_TURN_CAP_SECONDS=
FREE_DAILY_TURNS=
FAMILY_CLUB_DAILY_TURNS=
RETENTION_DAYS=
LESSONS_DIR=

# --- provider ---
TUTOR_PROVIDER=
OPENAI_API_KEY=
OPENAI_BASE_URL=
TUTOR_MODEL=
REALTIME_MODEL=
REALTIME_VOICE=
REALTIME_TURN_DETECTION=
REALTIME_GRACE_SECONDS=
PROVIDER_TIMEOUT_MS=
OPENAI_EXTRA_HEADERS=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=
STANDARD_DAILY_SECONDS=
PREMIUM_LIVE_DAILY_SECONDS=

# --- cost model ---
MONTHLY_BUDGET_USD=
STT_MODE=
STT_MODEL=
TTS_MODE=
TTS_MODEL=
TURN_CACHE_TTL_SECONDS=

# --- rate limits ---
RATE_LIMIT_IP_PER_MINUTE=
RATE_LIMIT_SESSION_TURNS_PER_MINUTE=
