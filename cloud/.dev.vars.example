# Copy to cloud/.dev.vars (gitignored) for `wrangler dev --local` and the tests.
# Names only: NEVER put a real value in this example file or in git.
#
# In dev/staging/production these are Cloudflare secrets:
#   wrangler secret put PARENT_TOKEN_SECRET --env dev
#
# HMAC key for parent tokens (pt1.*) and parental-approval tokens (pa1.*).
# Generate one: openssl rand -hex 32
PARENT_TOKEN_SECRET=
# OpenAI: only when set does POST /v1/tutor/realtime/token mint a token and does
# the turn provider leave the deterministic mock (Agent E's module). Absent on this machine.
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Free chat (T2, cloud/src/tutor/chat_config.ts): plain vars, not secrets. Default OFF in
# code; honoured in DEV_MODE only. Context window K (exchanges), spoken-word cap, max output tokens.
FREE_CHAT_ENABLED=
CHAT_CONTEXT_TURNS=
CHAT_RESPONSE_MAX_WORDS=
CHAT_MAX_OUTPUT_TOKENS=
# App Store Server API (Agent F, cloud/src/billing) - names reserved, not read yet.
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Sign in with Apple (cloud/src/auth/identity/apple.ts): accepted `aud` values of the
# identity token. APPLE_BUNDLE_ID = the app (native flow), APPLE_SERVICE_ID = the
# Services ID used by the web flow on littledays.joinanny.com. Plain vars, not secrets.
# Both empty -> POST /v1/parents {provider:"apple"} answers 501.
APPLE_BUNDLE_ID=
APPLE_SERVICE_ID=
# Google Sign-In (cloud/src/auth/identity/google.ts): comma-separated OAuth client ids
# (iOS client id, web client id) accepted as the ID token `aud`. Empty -> 501.
GOOGLE_CLIENT_IDS=
# Google Play (Agent F) - names reserved, not read yet.
GOOGLE_PLAY_PACKAGE=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_RTDN_PUBSUB_TOKEN=
