{
  "name": "little-days-cloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Little Days cloud backend: Cloudflare Workers + D1 + Durable Objects for the Aliz AI Tutor (sessions, quota, entitlements, consent, progress).",
  "scripts": {
    "dev": "wrangler dev --local --env dev",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "migrate:local": "wrangler d1 migrations apply little-days-dev --local --env dev",
    "deploy:dev": "wrangler deploy --env dev",
    "deploy:staging": "wrangler deploy --env staging"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^4.20250620.0",
    "@types/node": "^26.6.2",
    "typescript": "^5.8.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.124.0"
  },
  "dependencies": {
    "@cloudflare/voice": "^0.5.0",
    "agents": "^0.24.0",
    "hono": "^4.13.8"
  }
}
